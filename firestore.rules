rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User documents and subcollections strictly isolated by Auth UID
    match /users/{userId} {
      allow get, write: if isOwner(userId) && isValidId(userId);

      // Subcollection of employees belonging exclusively to the authenticated user
      match /employees/{employeeId} {
        allow read, write: if isOwner(userId) && isValidId(userId) && isValidId(employeeId);
      }
    }
  }
}
